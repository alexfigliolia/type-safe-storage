{
  "name": "@figliolia/type-safe-storage",
  "version": "2.0.0",
  "description": "A type-safe wrapper around React Native's Async Storage",
  "keywords": [
    "android",
    "async-storage",
    "iOS",
    "local-storage",
    "react",
    "react-native",
    "typescript",
    "windows"
  ],
  "homepage": "https://github.com/alexfigliolia/type-safe-storage#readme",
  "license": "MIT",
  "author": "Alex Figliolia",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexfigliolia/type-safe-storage.git"
  },
  "files": [
    "dist",
    "src/*"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "lint": "oxlint --type-aware --type-check --report-unused-disable-directives --fix && oxfmt",
    "test": "jest"
  },
  "devDependencies": {
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@types/node": "^26.6.4",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.72.0",
    "oxlint-tsgolint": "^0.24.0",
    "tsc-alias": "^1.8.6",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "unrun": "^0.3.1"
  },
  "peerDependencies": {
    "@react-native-async-storage/async-storage": ">=3.0.0"
  },
  "packageManager": "pnpm@10.33.2+sha512.a90faf6feeab71ad6c6e57f94e0fe1a12f5dcc22cd754db40ae9593eb6a3e0b6b12e3540218bb37ae083404b1f2ce6db2a4121e979829b4aff94b99f49da1cf8"
}
